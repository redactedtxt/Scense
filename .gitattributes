# Store text files with LF in the repo and check them out with LF on every OS.
* text=auto eol=lf

# Binary files: never convert line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.bmp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.pdf binary
*.parquet binary
