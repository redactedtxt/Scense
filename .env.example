# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_PASSWORD=
DATABASE_URL=postgres://scense:<POSTGRES_PASSWORD>@localhost:5432/scense

# --- API ---
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
ADMIN_TOKEN=

# --- AI ---
# Local dev: put your key in the repo-root .env (git ignores it), then run
# `docker compose up -d api`. Blank = the chat says "unavailable"; tests never use it.
ANTHROPIC_API_KEY=
GUEST_DAILY_CONVERSATION_CAP=100

# --- Deploy (GitHub Actions secrets; listed here for reference only) ---
# In production, deploy.yml writes the server's .env from the GitHub secrets on every
# deploy (see docs/DEPLOY_RUNBOOK.md); nobody edits it by hand.
EC2_HOST=
EC2_USER=
EC2_SSH_KEY=
AWS_BACKUP_BUCKET=
